generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  MASTER_ADMIN
  ADMIN
  EDITOR
  USER
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  avatar    String?
  bio       String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Blog {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  description    String?    @db.Text
  content        String?    @db.Text
  image          String?
  status         BlogStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  author         String
  category       String?
  tags           String?    @db.Text
  tag            String?
  date           String?
  readTime       String?
  excerpt        String?    @db.Text
  featured       Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("blogs")
  @@index([slug])
  @@index([status])
  @@index([category])
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  caption   String?
  category  String   @default("Common Spaces")
  alt       String?
  src       String   @unique
  order     Int      @default(0)
  status    String   @default("published")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gallery_items")
  @@index([category])
  @@index([status])
  @@index([order])
}

model RoomImage {
  id        String   @id @default(cuid())
  roomSlug  String
  src       String
  alt       String?
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("room_images")
  @@index([roomSlug, order])
}

model HomepageContent {
  id          String   @id @default(cuid())
  section     String   @unique
  data        String   @db.Text
  updatedAt   DateTime @updatedAt

  @@map("homepage_content")
}

model RoomContent {
  id          String   @id @default(cuid())
  roomSlug    String   @unique
  name        String?
  category    String?
  size        String?
  view        String?
  floor       String?
  description String?  @db.Text
  facilities  String?  @db.Text
  updatedAt   DateTime @updatedAt

  @@map("room_content")
  @@index([roomSlug])
}

model PageContent {
  id        String   @id @default(cuid())
  pageKey   String   @unique
  data      String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("page_content")
  @@index([pageKey])
}

model Setting {
  id         String @id @default(cuid())
  key        String @unique
  value      String   @db.Text
  type       String @default("string")
  group      String @default("general")
  updatedAt  DateTime @updatedAt

  @@map("settings")
  @@index([key])
  @@index([group])
}

model Media {
  id          String   @id @default(cuid())
  url         String
  publicId    String?
  alt         String?
  category    String?
  width       Int?
  height      Int?
  size        Int?
  mimeType    String?
  blobData    Bytes?   @db.LongBlob
  createdAt   DateTime @default(now())

  @@map("media")
}

model ContactMessage {
  id         String   @id @default(cuid())
  name       String
  email      String
  subject    String?
  message    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("contact_messages")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  content   String
  image     String?
  rating    Int      @default(5)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
}

model Feature {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("features")
}